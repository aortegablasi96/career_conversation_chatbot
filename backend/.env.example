# Copy this file to backend/.env and fill in the values.

# --- Required ---

# OpenAI: LLM calls (all agents) and embeddings (text-embedding-3-small, also used by data_pipeline/ingest.py)
OPENAI_API_KEY=

# Cohere: reranking of retrieved documents (rerank-english-v3.0)
COHERE_API_KEY=

# Pushover: notifications for contact requests and unknown questions
PUSHOVER_USER=
PUSHOVER_TOKEN=

# --- Optional ---

# LangSmith: agent/graph tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Telegram bot (webhook is only registered when BOT_TOKEN is set)
BOT_TOKEN=
# Base URL for the Telegram webhook; defaults to RENDER_EXTERNAL_URL (set by Render).
# Set this to your ngrok URL when testing locally.
TELEGRAM_WEBHOOK_URL=
